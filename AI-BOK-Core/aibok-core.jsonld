   "@id": "urn:aibok:FM25",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "urn:aibok:scheme"
   },
   "skos:notation": "FM25",
   "dct:identifier": "AIB-FM-025",
   "skos:prefLabel": [
    {
     "@value": "Cascading error propagation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "One agent's faulty or manipulated output is accepted by the next agent without its own check and grows into action.",
    "@language": "en"
   },
   "aibok:primaryKnowledgeArea": [
    {
     "@id": "urn:aibok:KA3"
    },
    {
     "@id": "urn:aibok:KA8"
    },
    {
     "@id": "urn:aibok:KA9"
    }
   ],
   "aibok:boundBy": [
    {
     "@id": "urn:aibok:Mandate"
    },
    {
     "@id": "urn:aibok:PolicyAsCode"
    },
    {
     "@id": "urn:aibok:Escalation"
    }
   ],
   "aibok:owaspMapping": "ASI08",
   "aibok:mastMapping": [
    "MAST 3.2 No or incomplete verification (partial)",
    "MAST 3.3 Incorrect verification (partial)"
   ],
   "aibok:status": "active"
  },
  {
   "@id": "urn:aibok:FM26",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "urn:aibok:scheme"
   },
   "skos:notation": "FM26",
   "dct:identifier": "AIB-FM-026",
   "skos:prefLabel": [
    {
     "@value": "Oversight degradation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Human oversight becomes nominal: rubber-stamp approvals, agents misreporting outcomes, or agents reaching the oversight or kill-switch configuration.",
    "@language": "en"
   },
